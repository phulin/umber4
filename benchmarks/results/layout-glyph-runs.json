{
  "date": "2026-11-01",
  "baseline_commit": "6439f83528160f7fbb63acafd154d9c245113ae3",
  "change": "Retain ordered 24-byte glyph-run/rule records and one pooled glyph-byte buffer instead of absolute per-glyph placements. Runs use absolute origins and page-local immutable font metrics. Forward owned Placement iteration reconstructs intra-run positions without a cached position array.",
  "build": {
    "cpu": 3,
    "cpu_model": "AMD EPYC 7642 48-Core Processor",
    "rustc": "rustc 1.98.1 (48a229cea 2026-09-01)",
    "build": "cargo build --release --bin umber --lib; default features, workspace fat LTO and one codegen unit, no extra RUSTFLAGS"
  },
  "measurement_scope": {
    "ordinary_CLI": "Warm fixed input/font files; includes process startup, source/font reads, registration/scaling, execution/layout, page lowering and publication, message handling and normal teardown. Existing layout.child measures child user+system CPU. One warmup and seven measured serial alternating before/after pairs per case.",
    "external_construction": "External adapter linked with rustc -C opt-level=3 -C lto=fat -C codegen-units=1 to each ordinary release library. CLOCK_THREAD_CPUTIME_ID spans Engine::new, register_tfm for preloaded resources, advance(MAX), and outcome(). Includes parsing/copying/scaling font resources, execution/layout, page lowering/node release, prefix publication and outcome count/message copying. Excludes host source/TFM reads and Engine/Outcome teardown. The preceding independent Outcome remains live during the next construction; replacement/drop is outside timing.",
    "one_scan": "Immediately after construction, visit every owned Placement and checksum font/character/coordinates or rule geometry. Includes the temporary Pages::iter chunk directory and its allocation/drop. Engine remains live; no positions are materialized.",
    "external_sampling": "Eight invocations per version/case in serial alternating order; first invocation discarded. Each invocation constructs seven fresh engines and discards its first engine sample. The retained 42 construction/one-scan pairs are grouped in seven processes, with six consecutive pairs per process. They are not 42 independent processes.",
    "repeat_scan": "After dropping Engine, retain the final Outcome and scan it 100 times. Report seven batch means per version/case and their median. Cache warmth differs from the immediate first scan.",
    "limitations": "Short shared-host measurements do not establish general TeX/LaTeX or browser behavior. CLI and external adapter have different call graphs and teardown/input scopes. No attribution of mixed-specific excess over native is claimed."
  },
  "allocation_scope": "A separate external counting allocator measures ordinary release engine construction/execution, excluding host source/TFM buffers. Record completion live/peak/requested bytes, then retain Outcome while dropping Engine, validate retained glyph/font access, and release all owners. Separate source-copy instrumentation counts output backing/class growth/copies; its extra 32 bytes per Store header are excluded from descriptor totals. Allocator headers/rounding, stack and OS mappings are excluded. No counters enter timing binaries. Earlier baseline output backing totals apply because output/lowering layouts and the fixed outputs were unchanged through 6439f83.",
  "record_sizes": {
    "Placement": 20,
    "OutputItem": 24,
    "Page_before": 1104,
    "Page_after": 1128,
    "header_chunk_request_before": 17712,
    "header_chunk_request_after": 18096,
    "singleton_character_live_before": 20,
    "singleton_character_live_after": 25
  },
  "tradeoffs": [
    "Requests increase 472 -> 590 for book and 545 -> 654 for mixed. Additional glyph-buffer backing and descriptors increase request counts while requested bytes fall 56.0% and 42.8%. Output backing allocations increase 172 -> 258 and 227 -> 305; allocations remain pooled backing requests, not per-run or per-glyph owners.",
    "First positioned scans slow 2.63x for book and 1.86x for mixed. Warm repeated scans slow 3.82x and 2.71x. Added scan CPU ranges from 0.37 to 0.85 ms across these first/warm measurements; every consumer scan repeats metric reads and coordinate reconstruction.",
    "All-singleton glyph output uses 25 bytes per glyph instead of 20, a 25% live-record increase before header/pool effects. There is no fallback representation.",
    "placements() deliberately changes from a borrowed slice with indexing/slicing to forward owned iteration. Immutable compact records and glyph bytes are exposed for sequential consumers.",
    "One record enum, one extra typed pool/buffer, scalar pending-run state and one positioning iterator replace the old placement array. Output and lowering modules remain below 600 lines."
  ],
  "validation": {
    "prototype": "179 ordinary tests and all three native font/paragraph/page adapters passed. Fixed book/mixed complete outputs, native DVI placements and retained-checkpoint replay matched baseline. Full checks preceded measurement; no full suite was repeated for source-identical integration.",
    "focused_semantics": "New tests cover wrapping positions and retained metrics after engine drop, eager aggregate u32 glyph/rule capacity, nested and empty box entry/exit, zero/negative glue, kerns, painted/unpainted rules and cumulative rounding.",
    "miri": "All three new output tests, lowering_error_publishes_nothing_and_reuses_cleared_scratch, and output_font_binding_crosses_nested_boxes_and_resets_for_each_page passed nightly Miri with strict provenance.",
    "prototype_checks": "rustfmt, all-target Clippy with warnings denied, ordinary release CLI/library build and wasm32-unknown-unknown library build passed.",
    "independent_review": "No actionable correctness findings; reviewed eager errors/order, aliases and first-use resources, aggregate/ranges, wrapping, boundaries, ownership and consumer/API tradeoffs.",
    "integration": "Exact runtime/test source identity with measured prototype verified. Three output tests and seventeen page tests, rustfmt, all-target Clippy, Wasm and ordinary release rebuild passed."
  },
